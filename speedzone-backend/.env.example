# Copie este arquivo para ".env" e ajuste. NUNCA envie o .env para o GitHub.

# "desenvolvimento" mostra detalhes dos erros no JSON; em produção use "producao"
APP_ENV=desenvolvimento

# URL pública da pasta /public (usada para montar o link das imagens).
# Deixe vazio para o sistema descobrir sozinho.
# Ex.: http://localhost/speedzone-backend/public
APP_URL=

# Banco de dados MySQL (o mesmo servidor que você vê no MySQL Workbench).
# Use a senha que você definiu ao instalar o MySQL. Se estiver errada, o instalador pergunta e corrige.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=speedzone
DB_USER=root
DB_PASS=""

# Origens do front-end autorizadas a chamar a API de outro endereço (separadas por vírgula).
# Ex.: http://localhost:5500,http://127.0.0.1:5500   (deixe vazio se o front ficar no mesmo domínio)
CORS_ORIGINS=

# Regras de negócio
OFICINA_DESCONTO_PERCENTUAL=5
FRETE_ORIGEM_UF=PR
FRETE_GRATIS_ACIMA=499.00
PEDIDO_EXPIRA_HORAS=48
LOJA_ENDERECO="Av. Exemplo, 1000 - Curitiba/PR (retirada na loja)"
